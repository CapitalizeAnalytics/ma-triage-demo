# Copy this file to .env and fill it in. .env is gitignored; never commit it.

# Your Anthropic API key, with access to Managed Agents
ANTHROPIC_API_KEY=

# Optional: IDs to reuse instead of creating new ones each run (triage_demo.py).
# Copy them from a previous run's runs/<run>/ids.json. Leave blank to create new ones.
AGENT_ID=
ENVIRONMENT_ID=
